<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ~ mftlrs: the whole screen is FileListScreen in Compose, so the drawer is beside the toolbar
      ~ instead of under it.
      -->
    <me.zhanghai.android.files.ui.PersistentDrawerLayout
        android:id="@+id/persistentDrawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <me.zhanghai.android.files.ui.NavigationFrameLayout
            android:id="@+id/navigationFragment"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?colorSurface" />

        <!-- mftlrs: window insets are taken on screenLayout, see layout/file_list_fragment_include.xml. -->
        <FrameLayout
            android:id="@+id/screenLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/composeView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </me.zhanghai.android.files.ui.PersistentDrawerLayout>
</merge>
