<!--
  ~ mftlrs: the whole screen with the navigation drawer is in Compose. Window insets are taken by a
  ~ listener in FileListFragment on screenLayout, not on ComposeView: Compose may replace the insets
  ~ listener of its own view.
  -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
