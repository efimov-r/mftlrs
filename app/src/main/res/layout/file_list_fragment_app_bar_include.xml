<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- app:statusBarBackground is broken when scrolling. -->
    <!-- mftlrs: панель всегда цвета colorSurfaceContainer (как поднятая), без liftOnScroll. -->
    <me.zhanghai.android.files.ui.CoordinatorAppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurfaceContainer"
        android:theme="?actionBarTheme"
        app:liftOnScroll="false">

        <!-- mftlrs: основная панель и панель выделения поверх неё — FileListTopBar в Compose. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/toolbarComposeView"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            app:layout_scrollFlags="@integer/file_list_toolbar_scroll_flags" />

        <!-- mftlrs: хлебные крошки — FileListBreadcrumbs в Compose. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/breadcrumbComposeView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tab_layout_height" />
    </me.zhanghai.android.files.ui.CoordinatorAppBarLayout>
</merge>
